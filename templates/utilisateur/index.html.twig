{% extends 'base.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
    <div class="container py-5">

        {# En-tête #}
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center mb-4 gap-3">

            <div>
                <h1 class="h2 fw-bold mb-1">
                    Liste des utilisateurs
                </h1>
                <p class="text-muted mb-0">
                    Gérez les utilisateurs de votre application.
                </p>
            </div>

            <a href="{{ path('add_user') }}"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Ajouter un utilisateur
            </a>
        </div>

        {# Tableau des utilisateurs #}
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">
                            <tr>
                                <th class="px-3">ID</th>
                                <th>Nom</th>
                                <th>Prénom</th>
                                <th>Âge</th>
                                <th>Email</th>
                                <th>Rôles</th>
                                <th>Date de création</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% if users is defined %}
                            {% for user in users %}
                                <tr>
                                    <td class="px-3 fw-semibold">
                                        {{ user.id }}
                                    </td>

                                    <td>{{ user.nom }}</td>

                                    <td>{{ user.prenom }}</td>

                                    <td>
                                        {{ user.age is not null ? user.age : '-' }}
                                    </td>

                                    <td>
                                        <span class="text-break">
                                            {{ user.email }}
                                        </span>
                                    </td>

                                    <td>
                                        {% for role in user.roles %}
                                            {% if role == 'ROLE_ADMIN' %}
                                                <span class="badge text-bg-danger mb-1">
                                                    Administrateur
                                                </span>
                                            {% elseif role == 'ROLE_USER' %}
                                                <span class="badge text-bg-primary mb-1">
                                                    Utilisateur
                                                </span>
                                            {% else %}
                                                <span class="badge text-bg-secondary mb-1">
                                                    {{ role }}
                                                </span>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted">Aucun rôle</span>
                                        {% endfor %}
                                    </td>

                                    <td class="text-nowrap">
                                        {{ user.createdAt
                                            ? user.createdAt|date('d/m/Y H:i')
                                            : '-' }}
                                    </td>

                                    <td class="text-center text-nowrap">
                                        <a href="{{ path('update_user', {
                                            id: user.id
                                        }) }}"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square me-1"></i>
                                            Modifier
                                        </a>

                                       

                                        <form method="post"
                                              action="{{ path('delete_user', { id: user.id }) }}"
                                              class="d-inline"
                                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">
                                            <input type="hidden" name="_method" value="DELETE">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash me-1"></i>
                                                Supprimer
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="8" class="text-center py-5">
                                        <div class="text-muted mb-2">
                                            <i class="bi bi-people fs-1"></i>
                                        </div>
                                        <h5>Aucun utilisateur trouvé</h5>
                                        <p class="text-muted mb-3">
                                            Commencez par ajouter un utilisateur.
                                        </p>
                                        <a href="{{ path('add_user') }}"
                                           class="btn btn-primary btn-sm">
                                            Ajouter un utilisateur
                                        </a>
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>

                    </table>
                </div>

            </div>

            {# Pied du tableau #}
            <div class="card-footer bg-white text-muted small">
                Liste des utilisateurs enregistrés
            </div>
        </div>

    </div>
{% endblock %}
